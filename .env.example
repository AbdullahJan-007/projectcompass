# ==============================================================================
# ProjectCompass Environment Configuration Template
# Copy to .env for local development. NEVER commit .env to Git.
# All variables are validated at startup via src/lib/env.ts (Zod).
# ==============================================================================

# --- Application ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Supabase PostgreSQL 17 + pgvector) ---
# Runtime pooled connection (Transaction Pooler, port 6543, pgbouncer=true)
# Note: URL-encode special password characters (e.g. # -> %23)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# Session pooler connection for Prisma migrations & seeding (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# --- Authentication & HMAC Session Signing ---
# Required in production (minimum 32 random hex characters — fail-closed)
AUTH_SECRET="replace_with_64_char_random_hex_hmac_secret"

# --- Bootstrap University Admin Account (Seeded into Supabase) ---
# Provisioned into User + FacultyAccount (role: ADMIN) via `pnpm db:seed`
BOOTSTRAP_ADMIN_NAME="University Admin Block"
BOOTSTRAP_ADMIN_EMAIL="admin@university.edu"
BOOTSTRAP_ADMIN_PIN="2026"

# --- Local-Only Demo Data Guard ---
# NEVER set to "true" in production/Vercel. Local & CI testing only.
SEED_DEMO_DATA="false"

# --- AI & Embeddings (OpenAI-Compatible via Vercel AI SDK) ---
# Works with Google Gemini (OpenAI-compatible endpoint) or OpenAI
AI_PROVIDER_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_API_KEY="replace_with_gemini_or_openai_api_key"
AI_CHAT_MODEL="gemini-3.8-flash"
AI_EMBEDDING_MODEL="gemini-embedding-001"
AI_MAX_OUTPUT_TOKENS="2500"
AI_REQUEST_TIMEOUT_MS="25000"

# --- Optional: Background Jobs (Inngest) ---
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Optional: Transactional Email (Resend) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ProjectCompass <notifications@university.edu>"
RESEND_WEBHOOK_SECRET=""
